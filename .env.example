# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Google Maps Platform API key — needs Places API (New) + Distance Matrix enabled.
GOOGLE_MAPS_API_KEY=

# Turso (LibSQL) database — required on Vercel. Create one with the Turso CLI:
#   turso db create vaidyaroute
#   turso db show vaidyaroute --url          → TURSO_DATABASE_URL
#   turso db tokens create vaidyaroute       → TURSO_AUTH_TOKEN
# Locally these can be left blank: the app falls back to a SQLite file in ./data.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Note: the starting address and evening visit window are configured in-app on
# the Settings page (stored in the database), not via environment variables.
